# Zmienne środowiskowe serwera aplikacji „Przewodnik przyszłej mamy”.
# Skopiuj ten plik do web/.env.local i uzupełnij wartości. Plik .env.local zostaje poza repozytorium.
# Zmienne bez przedrostka NEXT_PUBLIC_ czyta wyłącznie kod serwera (src/serwer/ i src/app/api/). Zmienne NEXT_PUBLIC_ADRES_*
# na końcu pliku trafiają do kodu przeglądarki przy `pnpm build`.

# Dostawca modelu językowego asystenta AI i odczytu dokumentów: deepseek albo anthropic. Puste pole oznacza deepseek.
MODEL_DOSTAWCA=deepseek

# Klucz API DeepSeek dla asystenta AI i odczytu dokumentów. Puste pole przy MODEL_DOSTAWCA=deepseek wyłącza model:
# asystent pokazuje komunikat 0071, a odczyt dokumentu komunikat 0108. Dokument przykładowy z web/public/przyklady odczytasz
# wtedy z fikstur odczytu po wybraniu w /demo/ustawienia opcji „Wynik odczytu zapisany w prototypie” (dokument rozpoznajemy po identyfikatorze w treści pliku).
DEEPSEEK_API_KEY=

# Identyfikator modelu DeepSeek. Puste pole oznacza deepseek-flash. Model deepseek-flash przyjmuje tekst, obrazy
# (JPEG, PNG, WebP i GIF) i pliki. Plik PDF serwer wgrywa najpierw do Files API DeepSeek, które parsuje dokument
# odpłatnie według liczby stron. Odczyt obrazów i plików PDF korzysta z deepseek-flash także wtedy,
# gdy ta zmienna wskazuje model tekstowy, na przykład deepseek-v4-pro.
DEEPSEEK_MODEL=deepseek-flash

# Klucz API Anthropic, opcjonalny. Serwer używa go wyłącznie przy MODEL_DOSTAWCA=anthropic, wtedy dla asystenta AI
# i odczytu dokumentów PDF i obrazów przykładowych spraw. Opcja odczytu „Wynik odczytu zapisany w prototypie” w /demo/ustawienia działa bez klucza.
ANTHROPIC_API_KEY=

# Identyfikator modelu Claude. Puste pole oznacza claude-opus-5-5, dla którego dobrano parametry wywołań.
ANTHROPIC_MODEL=claude-opus-5-5

# Ścieżka do katalogu z plikami JSON zestawów przykładowych spraw ZUS, bezwzględna albo względna wobec folderu web/.
# Punkt końcowy GET /api/przykladowe-sprawy/zestawy czyta z niego sprawy. Puste pole daje pustą listę spraw.
PRZYKLADOWE_SPRAWY_ZUS_KATALOG=

# Ścieżka do katalogu, w którym usługa /api/katalog zapisuje plik katalog.json z edycjami Administratora,
# bezwzględna albo względna wobec folderu web/. Puste pole oznacza web/.dane/, który zostaje poza repozytorium.
# Edycje są wspólne dla wszystkich użytkowników aplikacji, a wartości startowe katalogu zostają w kodzie.
KATALOG_DANE_KATALOG=

# Token zapisu katalogu dla systemów i skryptów spoza przeglądarki: nagłówek Authorization: Bearer <token>.
# Puste pole wyłącza zapis tokenem.
PANEL_TOKEN=

# Tryb demonstracyjny zapisu katalogu: przeglądarka potwierdza rolę Administrator nagłówkiem X-Sesja-Demo
# z sesją konta Administrator ZUS. Wartość `nie` wyłącza ten sposób potwierdzenia roli, a puste pole oznacza tryb
# demonstracyjny. Wdrożenie produkcyjne ustawia `nie` i zapisuje katalog tokenem PANEL_TOKEN.
KATALOG_TRYB_DEMO=

# Adresy produkcyjne sposobów logowania i kanałów zewnętrznych (src/dane/parametry-produkcyjne.ts). Next.js wpisuje je
# w kod przeglądarki przy `pnpm build`. Puste pole prowadzi do makiety logowania albo do symulowanego serwisu.
NEXT_PUBLIC_ADRES_LOGOWANIA_MOBYWATEL=
NEXT_PUBLIC_ADRES_LOGOWANIA_EZUS=
NEXT_PUBLIC_ADRES_LOGOWANIA_MZUS=
NEXT_PUBLIC_ADRES_KANALU_EZUS=
NEXT_PUBLIC_ADRES_KANALU_EMPATIA=
NEXT_PUBLIC_ADRES_KANALU_MOBYWATEL=
NEXT_PUBLIC_ADRES_KANALU_GOV_ZGLOSZENIE_URODZENIA=
NEXT_PUBLIC_ADRES_KANALU_GOV_REJESTR_STANU_CYWILNEGO=
NEXT_PUBLIC_ADRES_KANALU_PUE_EZUS=
NEXT_PUBLIC_ADRES_KANALU_E_WIZYTA=
