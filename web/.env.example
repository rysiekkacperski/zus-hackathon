# Zmienne środowiskowe serwera aplikacji „Przewodnik przyszłej mamy”.
# Skopiuj ten plik do web/.env.local i uzupełnij wartości. Plik .env.local zostaje poza repozytorium.
# Zmienne czyta wyłącznie kod serwera (src/serwer/ i src/app/api/), więc nie mają przedrostka NEXT_PUBLIC_.

# Dostawca modelu językowego asystenta AI i odczytu dokumentów: deepseek albo anthropic. Puste pole oznacza deepseek.
MODEL_DOSTAWCA=deepseek

# Klucz API DeepSeek dla asystenta AI i odczytu dokumentów. Puste pole przy MODEL_DOSTAWCA=deepseek wyłącza model:
# asystent odpowiada regułami deterministycznymi albo komunikatem 0071, a odczyt dokumentu zwraca status „niedostepny”.
DEEPSEEK_API_KEY=

# Identyfikator modelu DeepSeek. Puste pole oznacza deepseek-flash. Model deepseek-flash przyjmuje tekst, obrazy
# (JPEG, PNG, WebP i GIF) i pliki. Plik PDF serwer wgrywa najpierw do Files API DeepSeek, które parsuje dokument
# odpłatnie według liczby stron. Odczyt obrazów i plików PDF korzysta z deepseek-flash także wtedy,
# gdy ta zmienna wskazuje model tekstowy, na przykład deepseek-v4-pro.
DEEPSEEK_MODEL=deepseek-flash

# Klucz API Anthropic, opcjonalny. Serwer używa go wyłącznie przy MODEL_DOSTAWCA=anthropic, wtedy dla asystenta AI
# i odczytu dokumentów PDF i obrazów przykładowych spraw. Tryb demonstracyjny odczytu działa na fiksturach bez klucza.
ANTHROPIC_API_KEY=

# Identyfikator modelu Claude. Puste pole oznacza claude-opus-5-5, dla którego dobrano parametry wywołań.
ANTHROPIC_MODEL=claude-opus-5-5

# Ścieżka do katalogu z plikami JSON zestawów przykładowych spraw ZUS, bezwzględna albo względna wobec folderu web/.
# Punkt końcowy GET /api/przykladowe-sprawy/zestawy czyta z niego sprawy. Puste pole daje pustą listę spraw.
PRZYKLADOWE_SPRAWY_ZUS_KATALOG=
